FROM python:3.12-slim
WORKDIR /core
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt
COPY app ./app
COPY server ./server
COPY archreactor ./archreactor
RUN useradd --create-home coreuser
USER coreuser
ARG CORE_VERSION=development
ENV CORE_VERSION=$CORE_VERSION
EXPOSE 50051
CMD ["python", "-m", "server.grpc_server", "--host", "0.0.0.0", "--port", "50051"]
