FROM python:3.12-slim
WORKDIR /core
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt && useradd --uid 10001 --create-home core
COPY app ./app
COPY service ./service
COPY archreactor_contract ./archreactor_contract
RUN chmod -R a+rX /core
ARG CORE_VERSION=development
ENV CORE_VERSION=$CORE_VERSION
USER 10001
EXPOSE 50051
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s CMD ["python", "-m", "service.healthcheck"]
CMD ["python", "-m", "service.server"]
